<ai>
    <!-- 1) 低血才防御：不影响常态连段 -->
    <and id="JX_HP25_DEF" interval="45">
        <action id="AI.hp(role,0.25);"/>
        <action id="AI2.defense(role);"/>
    </and>

    <!-- 2) 大招：有距离窗口 + 有冷却，防止乱放打断输出 -->
    <and id="JX_TSLS" interval="240">
        <action id="AI.enemy(role,260,120);"/>
        <action id="AI2.skill(role,'天翔龙闪');"/>
    </and>
    <and id="JX_JTLS" interval="280">
        <action id="AI.enemy(role,380,150);"/>
        <action id="AI2.skill(role,'九头龙闪');"/>
    </and>

    <!-- 3) 贴身连段：技能 + 普攻穿插（尽可能不断手） -->
    <and id="JX_YTZ_CLOSE" interval="10">
        <action id="AI.enemy(role,210,70);"/>
        <action id="AI2.skill(role,'影涂斩');"/>
    </and>
    <and id="JX_GLS_CLOSE" interval="10">
        <action id="AI.enemy(role,230,80);"/>
        <action id="AI2.skill(role,'光龙闪');"/>
    </and>

    <!-- 普攻连打：用多个节点模拟“连按普攻” -->
    <and id="JX_ATK_1" interval="1">
        <action id="AI.enemy(role,240,90);"/>
        <action id="AI2.skill(role,'普通攻击');"/>
    </and>
    <and id="JX_ATK_2" interval="1">
        <action id="AI.enemy(role,240,90);"/>
        <action id="AI2.skill(role,'普通攻击');"/>
    </and>
    <and id="JX_ATK_3" interval="1">
        <action id="AI.enemy(role,240,90);"/>
        <action id="AI2.skill(role,'普通攻击');"/>
    </and>
    <and id="JX_ATK_4" interval="1">
        <action id="AI.enemy(role,240,90);"/>
        <action id="AI2.skill(role,'普通攻击');"/>
    </and>

    <!-- 4) 中距离起手：拉回到贴身连段区 -->
    <and id="JX_TLZ_START" interval="16">
        <action id="AI.enemy(role,340,160);"/>
        <action id="AI2.skill(role,'土龙闪');"/>
    </and>
    <and id="JX_PJS_PULL" interval="18">
        <action id="AI.enemy(role,300,140);"/>
        <action id="AI2.skill(role,'破军式');"/>
    </and>

    <!-- 5) 远距离强贴脸：减少游走时间 -->
    <and id="JX_JLZ_GAPCLOSE" interval="22">
        <action id="AI.enemy(role,600,260);"/>
        <action id="AI2.skill(role,'绝龙闪');"/>
    </and>

    <!-- 6) 追击/巡逻放最后，且 interval 不要太小 -->
    <and id="JX_CHASE" interval="10">
        <action id="AI.hate(role);"/>
        <action id="AI.chase(role,140);"/>
    </and>
    <and id="JX_MOVE" interval="80">
        <action id="AI2.move(role);"/>
    </and>
</ai>